# ─── Supabase / Datenbank ─────────────────────────────────────────────────────
# Supabase Dashboard → Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Direkte Verbindung für Prisma Migrate (kein Connection Pooler)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://vils17-kalender.onrender.com
# Zufälliger 32-Zeichen String: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_32_CHARS

# ─── Smoobu ───────────────────────────────────────────────────────────────────
# Smoobu Dashboard → Settings → API Key
SMOOBU_API_KEY=
# HMAC-Secret (Pflicht ab 31.10.2026, Smoobu → Einstellungen → API). Ohne Secret wird
# übergangsweise der alte "Api-Key"-Header gesendet.
SMOOBU_API_SECRET=
# Selbst gewähltes Secret – auch in Smoobu Webhook-Einstellungen eintragen
SMOOBU_WEBHOOK_SECRET=CHANGE_ME

# ─── E-Mail (SMTP) ────────────────────────────────────────────────────────────
# Postfach info@vils17.at (Strato) — SMTP_USER/SMTP_PASS fallen auf IMAP_USER/IMAP_PASS zurück
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_FROM_NAME="Vils17 · Lodge & Penthouse No. 17"
# Alternativ: Resend.com
# RESEND_API_KEY=re_...

# ─── Twilio WhatsApp (optional) ───────────────────────────────────────────────
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Wäsche-Lieferant (Phase 2 – noch nicht aktiv) ────────────────────────────
LAUNDRY_API_ENABLED=false
LAUNDRY_API_URL=
LAUNDRY_API_KEY=

# ─── Cron-Job Sicherheit ──────────────────────────────────────────────────────
# Zufälliger String – muss in Render Cron-Konfiguration gesetzt sein
CRON_SECRET=CHANGE_ME

# ─── App ──────────────────────────────────────────────────────────────────────
# Muss die öffentliche Adresse sein — OAuth für claude.ai (Issuer, Zielgruppe
# der Token) baut darauf auf
NEXT_PUBLIC_APP_URL=https://vils17-kalender.onrender.com

# ─── Claude-Schnittstelle: OAuth (optional) ───────────────────────────────────
# Zusätzlich erlaubte Rücksprung-Adressen (kommagetrennt). Claude (claude.ai,
# claude.com) und Loopback (Claude Code) sind immer erlaubt.
# MCP_OAUTH_EXTRA_REDIRECTS=
# Hosts, deren Client-Metadaten-Dokumente geladen werden (Vorgabe: claude.ai,claude.com)
# MCP_OAUTH_CIMD_HOSTS=claude.ai,claude.com

# ─── Portal-Mail-Import (Gästezahl, Haustiere) ────────────────────────────────
# Postfach, in das die Bestätigungsmails von Booking.com / Airbnb weitergeleitet
# werden. Bei Gmail: App-Passwort verwenden, IMAP im Konto aktivieren.
IMAP_HOST=imap.strato.de
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Optional – Standard ist INBOX
IMAP_FOLDER=INBOX

# ─── Bewertungsanfrage nach der Abreise (src/lib/review-request.ts) ──────────
# Erst auf true setzen, wenn Smoobu-Vorlage 6 abgeschaltet ist — sonst bekommen Gäste zwei Nachrichten.
REVIEW_REQUEST_ENABLED=false
# Optional: Tag des Umstiegs (JJJJ-MM-TT). Nur Buchungen mit Abreise + 2 Tage ab diesem Tag werden angeschrieben,
# damit beim Nachholen (bis 7 Tage) niemand eine zweite Anfrage bekommt, den Smoobu schon angeschrieben hat.
# REVIEW_REQUEST_FROM=2026-11-01
