generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  CLEANER
}

enum CleaningStatus {
  UNASSIGNED
  SELF_CLEAN
  ASSIGNED
  COMPLETED
}

enum LaundryStatus {
  OPEN
  ORDERED
  AVAILABLE
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

// ─── Multi-Tenant ─────────────────────────────────────────────────────────────

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  plan             SubscriptionPlan @default(FREE)
  stripeCustomerId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users      User[]
  apartments Apartment[]

  @@map("organizations")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String
  passwordHash String
  role         Role    @default(CLEANER)
  phone        String?
  notes        String?
  language     String  @default("de")
  active       Boolean @default(true)
  isPrimary    Boolean @default(false)
  cleanerRate  Float   @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments            CleaningAssignment[]
  pushSubscriptions      PushSubscription[]
  preferredForApartments Apartment[]          @relation("ApartmentPreferredCleaner")

  @@unique([email, organizationId])
  @@index([organizationId])
  @@map("users")
}

// ─── Apartments ───────────────────────────────────────────────────────────────

model Apartment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  smoobuId    Int?
  name        String
  description String?
  color       String? // Hex-Farbe für Kalender, z.B. "#3b82f6"
  active      Boolean @default(true)

  // Wäsche-Konfiguration
  laundryBedsDivisor     Int @default(2) // 1 Bettset pro N Gäste (aufgerundet), z.B. 2 = 1 Set pro Doppelzimmer
  laundryTowelsPerGuest  Int @default(1) // Handtücher pro Gast
  laundryKitchenCount    Int @default(1) // Küchenhandtücher pro Buchung (fix)

  // Dreame Saugroboter
  dreameEnabled Boolean @default(false)

  // Feste Reinigungskraft-Zuweisung
  preferredCleanerId String?
  preferredCleaner   User?   @relation("ApartmentPreferredCleaner", fields: [preferredCleanerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@unique([smoobuId, organizationId])
  @@index([organizationId])
  @@map("apartments")
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id             String @id @default(cuid())
  organizationId String // denormalisiert für einfache Abfragen ohne JOIN

  smoobuId    Int?    @unique
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])

  guestName  String
  guestEmail String?
  guestPhone String?
  guestCount Int     @default(1)
  petCount   Int?    // Haustiere (manuell gepflegt, Smoobu liefert keine Daten)

  checkIn       DateTime
  checkOut      DateTime
  arrivalTime   String? // "15:00"
  departureTime String? // "10:00"

  channelName String? // "Airbnb", "Booking.com", "Direkt"
  price       Float?  // Brutto-Buchungspreis aus Smoobu
  currency    String? @default("EUR")
  status      String  @default("confirmed") // confirmed, cancelled, pending

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cleaningAssignment CleaningAssignment?

  @@index([organizationId, checkIn])
  @@index([organizationId, checkOut])
  @@index([apartmentId])
  @@map("bookings")
}

// ─── Cleaning Assignments ─────────────────────────────────────────────────────

model CleaningAssignment {
  id             String @id @default(cuid())
  organizationId String

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  cleanerId   String?
  cleaner     User?          @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  status      CleaningStatus @default(UNASSIGNED)
  isSelfClean Boolean        @default(false)
  notes       String?

  assignedAt DateTime?
  notifiedAt DateTime?

  // Reiniger-Absage
  cleanerUnavailable     Boolean  @default(false)
  cleanerUnavailableNote String?
  cleanerUnavailableAt   DateTime?

  // Wäsche
  laundryStatus      LaundryStatus @default(OPEN)
  laundryNotes       String?
  laundryOrderId     String? // ID beim Lieferanten
  laundryOrderedAt   DateTime?
  laundryOrderStatus String? // "pending", "confirmed", "error"
  // Menge: { beds: 3, towels: 6, kitchen: 1 }
  laundryQuantity    Json?

  // Auszahlung
  paidOut   Boolean   @default(false)
  paidOutAt DateTime?

  // Push-Erinnerungen (Cron-Tracking)
  cleanerReminderSentAt DateTime?
  adminReminderSentAt   DateTime?

  // Dreame Saugroboter
  dreameStartedAt DateTime?
  dreameDoneAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([cleanerId])
  @@map("cleaning_assignments")
}

// ─── Push Subscriptions ───────────────────────────────────────────────────────

model PushSubscription {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("push_subscriptions")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String  @id @default(cuid())
  organizationId String
  userId         String?

  action     String // "booking.synced", "assignment.created", "laundry.ordered"
  entityType String? // "Booking", "CleaningAssignment", "User"
  entityId   String?
  details    Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}
