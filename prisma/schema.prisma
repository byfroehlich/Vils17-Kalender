generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  CLEANER
}

enum CleaningStatus {
  UNASSIGNED
  SELF_CLEAN
  ASSIGNED
  COMPLETED
}

enum LaundryStatus {
  OPEN
  ORDERED
  AVAILABLE
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

// ─── Multi-Tenant ─────────────────────────────────────────────────────────────

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  plan             SubscriptionPlan @default(FREE)
  stripeCustomerId String?
  // Zeitpunkt des letzten erfolgreichen Smoobu-Syncs — steuert die
  // Selbstaktualisierung der App und zeigt, ob der Cron wirklich läuft
  lastSyncAt       DateTime?
  // Datum (Europe/Vienna, "YYYY-MM-DD"), an dem der Tagesstatus verschickt wurde
  dailyStatusSentOn String?
  // Wäsche-Reserve je Teil, die nach allen Anreisen immer noch im Keller liegen soll
  // ({ beds: 3, towels: 3, … }); null = Vorgabe aus laundry-stock.ts
  laundryReserve   Json?
  // Fingerabdruck der zuletzt gemeldeten Wäsche-Lage („reicht nicht ab …“): gleiche Lage →
  // keine neue Meldung; ändert eine Buchung/Storno die Lage → neue Meldung; reicht es
  // wieder → null (Entscheidung Mathias 31.10.2026)
  laundryAlertKey  String?
  // Letzter Lauf der Sonderwunsch-Erkennung in den Gästechats (gedrosselt, siehe note-suggestions.ts)
  noteScanAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  users        User[]
  apartments   Apartment[]
  emailImports EmailImport[]
  mcpTokens    McpToken[]
  laundryCounts     LaundryCount[]
  laundryDeliveries LaundryDelivery[]
  issues            Issue[]
  noteSuggestions   NoteSuggestion[]

  @@map("organizations")
}

// ─── MCP-Schnittstelle ────────────────────────────────────────────────────────
// Zugangstoken für Claude (MCP-Server unter /api/mcp). Gespeichert wird nur der
// SHA-256-Hash; das Klartext-Token wird beim Anlegen genau einmal angezeigt.

model McpToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  hash   String   @unique // SHA-256 (hex) des Tokens
  prefix String // erste Zeichen zur Wiedererkennung, z.B. "v17_Ab3x"
  scopes String[] // bookings:read, cleaning:read, cleaning:write, finance:read

  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  // Nur bei Token aus dem OAuth-Ablauf (claude.ai): Ablauf, Zielgruppe
  // (Adresse dieser MCP-Schnittstelle) und die Verbindung, zu der es gehört
  expiresAt     DateTime?
  resource      String?
  oauthFamilyId String?

  @@index([organizationId])
  @@index([oauthFamilyId])
  @@map("mcp_tokens")
}

// ─── OAuth 2.1 für claude.ai ──────────────────────────────────────────────────
// Die App ist ihr eigener Autorisierungsserver. Access-Token sind normale
// McpToken (mit Ablauf); Refresh-Token werden bei jeder Erneuerung getauscht.

model OAuthClient {
  id           String    @id @default(cuid())
  clientId     String    @unique // zufällig (DCR) oder HTTPS-URL (Client-ID-Metadaten-Dokument)
  kind         String // "dcr" | "cimd"
  name         String?
  redirectUris String[]
  createdAt    DateTime  @default(now())
  fetchedAt    DateTime? // CIMD: wann das Metadaten-Dokument zuletzt geladen wurde
  lastUsedAt   DateTime?

  @@map("oauth_clients")
}

model OAuthCode {
  id             String    @id @default(cuid())
  codeHash       String    @unique
  clientId       String
  organizationId String
  userId         String
  redirectUri    String
  codeChallenge  String
  scopes         String[]
  resource       String
  expiresAt      DateTime
  usedAt         DateTime?
  familyId       String // Verbindung, die mit diesem Code entsteht
  createdAt      DateTime  @default(now())

  @@map("oauth_codes")
}

model OAuthRefreshToken {
  id             String    @id @default(cuid())
  hash           String    @unique
  familyId       String // alle Refresh-Token einer Verbindung
  clientId       String
  organizationId String
  userId         String
  scopes         String[]
  resource       String
  expiresAt      DateTime
  usedAt         DateTime? // ausgetauscht — erneute Verwendung = Diebstahl → Familie sperren
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([familyId])
  @@map("oauth_refresh_tokens")
}

// ─── Portal-Mail-Import ───────────────────────────────────────────────────────
// Booking.com und Airbnb nennen in ihren Mails Angaben, die Smoobu nicht
// durchreicht (Erwachsene/Kinder, Haustiere). Jede verarbeitete Mail wird hier
// protokolliert — als Schutz vor Doppelverarbeitung und als Nachweis für den Admin.

model EmailImport {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messageId  String    @unique
  portal     String? // "booking.com" | "airbnb"
  subject    String?
  receivedAt DateTime?

  // APPLIED | NO_CHANGE | UNMATCHED | AMBIGUOUS | NO_DATA | ERROR
  status String
  detail String?

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  parsedGuestCount Int?
  parsedAdults     Int?
  parsedChildren   Int?
  parsedPets       Int?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("email_imports")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String
  passwordHash String
  role         Role    @default(CLEANER)
  phone        String?
  notes        String?
  language     String  @default("de")
  active       Boolean @default(true)
  isPrimary    Boolean @default(false)
  cleanerRate  Float   @default(50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments            CleaningAssignment[]
  declinedAssignments    CleaningAssignment[] @relation("AssignmentDeclinedBy")
  pushSubscriptions      PushSubscription[]
  preferredForApartments Apartment[]          @relation("ApartmentPreferredCleaner")
  rateForApartments      Apartment[]          @relation("ApartmentRateCleaner")

  @@unique([email, organizationId])
  @@index([organizationId])
  @@map("users")
}

// ─── Apartments ───────────────────────────────────────────────────────────────

model Apartment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  smoobuId    Int?
  name        String
  description String?
  color       String? // Hex-Farbe für Kalender, z.B. "#3b82f6"
  active      Boolean @default(true)

  // Wäsche-Konfiguration
  laundryBedsDivisor     Int @default(2) // 1 Bettset pro N Gäste (aufgerundet), z.B. 2 = 1 Set pro Doppelzimmer
  laundryTowelsPerGuest  Int @default(1) // Handtücher pro Gast
  laundryKitchenCount    Int @default(1) // Küchenhandtücher pro Buchung (fix)
  // Betten in Belegungsreihenfolge für Spannbettlaken-Größen, z.B. [{"width":200,"persons":2},{"width":180,"persons":2},{"width":90,"persons":1}]
  // null = Vorgabe über laundryBedsDivisor (180er)
  laundryBeds            Json?

  // Dreame Saugroboter
  dreameEnabled Boolean @default(false)
  // Bei genau 2 Gästen automatisch fragen: ein Schlafzimmer oder getrennt? (Penthouse, Entscheidung Mathias 31.10.2026)
  askSeparateBedrooms Boolean @default(false)

  // Feste Reinigungskraft-Zuweisung
  preferredCleanerId String?
  preferredCleaner   User?   @relation("ApartmentPreferredCleaner", fields: [preferredCleanerId], references: [id], onDelete: SetNull)

  // Vereinbarter Sondersatz pro Reinigung, z.B. 70 € für Vanessa im Penthouse.
  // Gilt nur für Buchungen, die ab cleaningRateFrom ins System kommen, und nur
  // für die genannte Reinigungskraft — Vertretungen bekommen ihren eigenen Satz.
  cleaningRate          Float?
  cleaningRateFrom      DateTime?
  cleaningRateCleanerId String?
  cleaningRateCleaner   User?     @relation("ApartmentRateCleaner", fields: [cleaningRateCleanerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@unique([smoobuId, organizationId])
  @@index([organizationId])
  @@map("apartments")
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id             String @id @default(cuid())
  organizationId String // denormalisiert für einfache Abfragen ohne JOIN

  smoobuId    Int?    @unique
  apartmentId String
  apartment   Apartment @relation(fields: [apartmentId], references: [id])

  guestName  String
  guestEmail String?
  guestPhone String?
  guestCount Int     @default(1)
  // true = Gästezahl wurde von Hand korrigiert; der Sync überschreibt sie dann
  // nicht mehr (Smoobu liefert für manche Kanäle keine Gästezahl)
  guestCountManual Boolean @default(false)
  // Woher die abweichende Gästezahl stammt: "manual" (Eingabe) oder "email" (Portal-Mail)
  guestCountSource String?
  // true = der Channel Manager hat keine Gästezahl geliefert (guestCount ist nur ein Notwert).
  // Die Wäscheplanung rechnet dann mit der vollen Belegung der Wohnung (vorsichtig).
  guestCountUnknown Boolean @default(false)
  // Einmalige Push-Warnung „Gästezahl unbekannt“ (≤ 30 Tage vor Anreise) verschickt
  // (Entscheidung Mathias 31.10.2026: unbestätigte Gästezahl muss sichtbar sein und geklärt werden)
  guestCountReminderSentAt DateTime?
  // Schlafzimmer-Frage an den Gast verschickt (einmal je Buchung, src/lib/bedroom-question.ts)
  bedroomQuestionSentAt DateTime?
  /// Gästechat als erledigt markiert („keine Antwort nötig“) bis zu dieser Nachricht (Smoobu-ID); neue Gastnachricht → wieder offen
  chatDoneMessageId     String?
  petCount   Int?    // Hunde (kein Portal liefert dafür ein eigenes Feld)
  // Woher petCount stammt: "manual" (Eingabe, wird nie überschrieben), "notice" (Portalnotiz), "chat" (Gästechat)
  petSource  String?
  // Kurzer Auszug der Stelle, an der der Hund erkannt wurde (zum Gegenprüfen)
  petHint    String?
  // Hundegebühr (nur wo das Portal sie nicht selbst kassiert, v.a. Booking.com):
  // null = noch nichts unternommen, REQUESTED = beim Gast angefordert, PAID, WAIVED = erlassen
  petFeeStatus      String?
  petFeeAmount      Float?   // Betrag der Anforderung (festgehalten beim Anfordern/Bezahlen)
  petFeeRequestedAt DateTime?
  petFeePaidAt      DateTime?
  // Freitext-Notiz aus dem Portal (Gastnachricht, Sonderwünsche, Haustier-Hinweise)
  channelNotice String?
  // Sondersatz-Vermerk, beim Eingang der Buchung von der Wohnung übernommen und
  // danach nie mehr verändert ("70-€-Buchung für Vanessa")
  premiumRate          Float?
  premiumRateCleanerId String?

  checkIn       DateTime
  checkOut      DateTime
  arrivalTime   String? // "15:00"
  departureTime String? // "10:00"

  channelName String? // "Airbnb", "Booking.com", "Direkt"
  price       Float?  // Brutto-Buchungspreis aus Smoobu
  currency    String? @default("EUR")
  status      String  @default("confirmed") // confirmed, cancelled, pending

  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cleaningAssignment CleaningAssignment?
  emailImports       EmailImport[]
  noteSuggestions    NoteSuggestion[]

  @@index([organizationId, checkIn])
  @@index([organizationId, checkOut])
  @@index([apartmentId])
  @@map("bookings")
}

// ─── Cleaning Assignments ─────────────────────────────────────────────────────

model CleaningAssignment {
  id             String @id @default(cuid())
  organizationId String

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  cleanerId   String?
  cleaner     User?          @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  status      CleaningStatus @default(UNASSIGNED)
  isSelfClean Boolean        @default(false)
  // „Hinweis für die Reinigung“ (z.B. Kinderbett) — EIN Feld, keine eigene Sonderwunsch-Spalte
  // (Entscheidung Mathias 31.10.2026). Vorschläge aus dem Gästechat landen erst nach Bestätigung hier.
  notes       String?
  // Zusätzliche Betten (Zustellbett, Sofa als Bett) für diese Anreise: je Bett ein 90er Spannbettlaken,
  // ein Bett- und ein Kissenbezug zusätzlich in der Wäscheplanung (0–3)
  extraBeds   Int            @default(0)

  assignedAt DateTime?
  notifiedAt DateTime?

  // Reiniger-Absage
  cleanerUnavailable     Boolean  @default(false)
  cleanerUnavailableNote String?
  cleanerUnavailableAt   DateTime?
  // Wer hat abgesagt — bleibt erhalten wenn jemand anderes den Job übernimmt,
  // damit der Absagende die Buchung weiterhin als "abgesagt" sieht
  declinedById String?
  declinedBy   User?   @relation("AssignmentDeclinedBy", fields: [declinedById], references: [id], onDelete: SetNull)

  // Wäsche
  laundryStatus      LaundryStatus @default(OPEN)
  laundryNotes       String?
  laundryOrderId     String? // ID beim Lieferanten
  laundryOrderedAt   DateTime?
  laundryOrderStatus String? // "pending", "confirmed", "error"
  // Menge: { beds: 3, towels: 6, kitchen: 1 }
  laundryQuantity    Json?

  // Satz dieses Auftrags — beim Erledigen festgeschrieben, damit spätere
  // Satzänderungen alte Abrechnungen nicht rückwirkend verändern
  rate Float?

  // Auszahlung
  paidOut   Boolean   @default(false)
  paidOutAt DateTime?

  // Push-Erinnerungen (Cron-Tracking)
  cleanerReminderSentAt DateTime?
  adminReminderSentAt   DateTime?
  laundryReminderSentAt DateTime?

  // Dreame Saugroboter
  dreameStartedAt DateTime?
  dreameDoneAt    DateTime?
  /// Warnung (Startfehler, Störung, zu lange) bereits gemeldet — nur einmal pro Auftrag
  dreameWarnedAt  DateTime?

  /// Inventar-/Verbrauchs-Check beim Erledigen beantwortet
  checkedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([cleanerId])
  @@map("cleaning_assignments")
}

// ─── Push Subscriptions ───────────────────────────────────────────────────────

model PushSubscription {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@map("push_subscriptions")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id             String  @id @default(cuid())
  organizationId String
  userId         String?

  action     String // "booking.synced", "assignment.created", "laundry.ordered"
  entityType String? // "Booking", "CleaningAssignment", "User"
  entityId   String?
  details    Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ─── Wäsche-Bestand (Keller) ──────────────────────────────────────────────────
// Gezählter Bestand sauberer Wäsche. Maßgeblich ist die jüngste Zählung; ab dem
// Tag danach werden Anreisen abgezogen und Lieferungen hinzugerechnet.
model LaundryCount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Kalendertag der Zählung (UTC-Mitternacht); der Bestand gilt am Ende dieses Tages
  countedOn      DateTime
  // { beds, towels, handTowels, pillowCases, duvetCovers, bathMats, washcloths, kitchen }
  quantities     Json
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, countedOn])
  @@map("laundry_counts")
}

// Bestellung bei der Wäscherei; zählt ab dem Liefertag zum Bestand.
model LaundryDelivery {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Liefertag (UTC-Mitternacht)
  deliveryOn     DateTime
  quantities     Json
  // Bestellnummer o.ä.
  reference      String?
  cancelled      Boolean      @default(false)
  // Lieferung im Keller angekommen (bestätigt). Erst dann zählt sie zum Bestand,
  // vorher gilt sie als „bestellt/unterwegs“ (Entscheidung Mathias 31.10.2026)
  arrivedAt      DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, deliveryOn])
  @@map("laundry_deliveries")
}

// Mangel am Inventar oder Verbrauchsmaterial zum Nachkaufen — von der Reinigung beim
// „Erledigt“ gemeldet oder von Hand erfasst. Hängt am Aufenthalt davor (Verursacher-
// Zuordnung, Meldefristen der Portale: Airbnb 14 Tage nach Abreise).
model Issue {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apartmentId       String
  /// "DAMAGE" (Schaden/Mangel) | "SUPPLY" (Verbrauchsmaterial nachkaufen)
  kind              String
  text              String
  /// Reinigungsauftrag, bei dem gemeldet wurde (Reinigung vor der Anreise von bookingId)
  assignmentId      String?
  /// Aufenthalt davor = möglicher Verursacher
  previousBookingId String?
  photo             Bytes?
  photoType         String?
  reportedById      String?
  reportedByName    String?
  createdAt         DateTime     @default(now())
  doneAt            DateTime?
  doneNote          String?

  @@index([organizationId, doneAt])
  @@map("issues")
}

// ─── Hinweis-Vorschläge aus dem Gästechat ─────────────────────────────────────
// Entscheidung Mathias 31.10.2026: Sonderwünsche (Kinderbett, Hochstuhl, Zustellbett …) werden
// in den Gästechats (Smoobu) erkannt und als Vorschlag abgelegt. Erst nach „Übernehmen“ werden sie
// an CleaningAssignment.notes angehängt. Jede Nachricht wird nur einmal verwertet.

model NoteSuggestion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Smoobu-Nachrichten-ID — je Nachricht höchstens ein Vorschlag
  messageId      String
  // Vorgeschlagener Hinweistext, z.B. "Kinderbett, Hochstuhl"
  proposedText   String
  // Auszug aus der Gästenachricht (≤ 200 Zeichen) zum Gegenprüfen
  excerpt        String
  // Vorgeschlagene Zusatzbetten (aus „Zustellbett“, „Sofa als Bett“ …)
  extraBeds      Int          @default(0)
  // PENDING | ACCEPTED | REJECTED
  status         String       @default("PENDING")
  createdAt      DateTime     @default(now())
  decidedAt      DateTime?
  decidedById    String?

  @@unique([organizationId, messageId])
  @@index([organizationId, status])
  @@map("note_suggestions")
}
